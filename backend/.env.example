# ── Copy this file to .env and fill in the values ──────────────────
#    cp .env.example .env
#
# ── Local Development ─────────────────────────────────────────────
# Only SECRET_KEY and DEBUG are required locally.
# All others fall back to safe defaults (see settings.py).

SECRET_KEY=django-insecure-dev-key-change-in-production-x9$k2m!@#
DEBUG=True

# Optional – defaults to * (all hosts) when unset
# ALLOWED_HOSTS=*

# Optional – defaults to localhost:5173 when unset
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Optional – defaults to SQLite when unset
# DATABASE_URL=postgresql://user:pass@localhost:5432/mydb

# ── Railway Production ───────────────────────────────────────────
# Railway auto-sets DATABASE_URL from its PostgreSQL plugin.
# Set these in Railway Dashboard → Variables:
#
#   SECRET_KEY=<generate a random secret>
#   DEBUG=False
#   ALLOWED_HOSTS=your-app.up.railway.app
#   CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
#   CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app
#   DJANGO_SUPERUSER_USERNAME=admin
#   DJANGO_SUPERUSER_EMAIL=admin@example.com
#   DJANGO_SUPERUSER_PASSWORD=<your-secure-password>
